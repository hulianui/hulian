{
  "name": "@hulianui/mcp",
  "version": "0.1.1",
  "description": "瑚琏 Hulian 的 MCP server —— 让 AI 按需查组件/区块/页面与使用约束，而不是猜签名或整吞 llms-full.txt。",
  "license": "MIT",
  "author": "hulianui",
  "homepage": "https://hulianui.haloritual.com",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "hulianui",
    "react",
    "component-library",
    "ai"
  ],
  "type": "module",
  "bin": {
    "hulianui-mcp": "./src/index.mjs"
  },
  "exports": {
    ".": "./src/index.mjs"
  },
  "files": [
    "src"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hulianui/hulian.git",
    "directory": "packages/mcp"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "scripts": {
    "typecheck": "node --check src/index.mjs && node --check src/data.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  }
}
