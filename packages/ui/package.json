{
  "name": "@hulianui/ui",
  "version": "0.22.0",
  "description": "瑚琏 Hulian —— 基于 OKLCH 主题与 Tailwind v4 的 React 组件库:340+ 组件、暗色零闪烁、运行时换肤、源码分发。",
  "license": "MIT",
  "author": "hulianui",
  "homepage": "https://hulianui.haloritual.com",
  "keywords": [
    "react",
    "component-library",
    "ui",
    "ui-components",
    "design-system",
    "tailwindcss",
    "tailwind-v4",
    "oklch",
    "base-ui",
    "headless-ui",
    "dark-mode"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hulianui/hulian.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/hulianui/hulian/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "exports": {
    ".": "./src/index.ts",
    "./showcase": "./src/showcase.ts",
    "./vitest-preset": {
      "types": "./vitest-preset.d.ts",
      "default": "./vitest-preset.js"
    },
    "./vite": {
      "types": "./vite.d.ts",
      "default": "./vite.js"
    },
    "./*": "./src/*/index.ts"
  },
  "files": [
    "src",
    "vitest-preset.js",
    "vitest-preset.d.ts",
    "vite.js",
    "vite.d.ts",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.bake.mjs"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@base-ui/react": ">=1.0.0",
    "motion": ">=11",
    "react": ">=18",
    "react-dom": ">=18",
    "tailwindcss": ">=4",
    "vite": ">=5"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.9",
    "@tiptap/extension-link": "^3.29.2",
    "@tiptap/extension-placeholder": "^3.29.2",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "@vidstack/react": "^1.15.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.21",
    "lucide-react": "^1.28.0",
    "ogl": "^1.0.11",
    "qrcode-generator": "^2.0.4",
    "react-colorful": "^5.8.0",
    "react-easy-crop": "^6.2.3",
    "react-is": "^19.2.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "tiptap-markdown": "^0.9.0"
  },
  "devDependencies": {
    "@base-ui/react": "^1.6.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/browser": "^3.2.7",
    "jsdom": "^25.0.0",
    "motion": "^12.43.0",
    "playwright": "^1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  }
}
