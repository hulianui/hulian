auto-install-peers=true

# 让根 package.json 的 engines 真正有牙齿：不满足就 install 失败，而不是打一行警告。
# 没有这条，engines 只是文档 —— 一台 Node 20.0~20.18 的机器照样能装上，然后崩在
# rolldown / native binding 上，报错栈毫无指向性。具体补丁版本由 .nvmrc / .node-version
# 统一（CI 四处 setup-node 都读 .nvmrc，托管平台读 .node-version）。
#
# engines.node 当前是 `^22.22.2 || ^24.15.0 || >=26.0.0`，比 vite 8 / jsdom 27.4 的交集
# （^20.19 || ^22.12 || >=24）窄得多，下限是被**一个 devDependency 的传递依赖**顶上去的：
#   react-doctor → effect@4.0.0-beta.70 → ini@7.0.0（engines.node ^22.22.2 || …）
# engine-strict 对依赖的 engines 同样是硬失败，所以这不是可选建议而是真实下限——写进
# engines 只是别让它撒谎。2026-08-01 主站构建就挂在这上面（平台按浮动的 `NODE_VERSION=22`
# 装了 22.22.0）。若哪天 react-doctor 出库，这里可以放宽回上面那个交集。
engine-strict=true

# @hulianui/* 发布在公共 npmjs（scope @hulianui，access public），消费方零配置零 token 即可安装。
# 本仓库内 @hulianui/* 为 workspace:* 内部解析，无需 registry 路由。
# CI 发布鉴权由 release.yml 的 actions/setup-node(registry-url=npmjs) + NODE_AUTH_TOKEN=NPM_TOKEN 处理。
