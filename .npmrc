auto-install-peers=true

# @hulianui 作用域包走 GitHub Packages（org=hulianui）
# 发布鉴权由 CI 的 actions/setup-node(registry-url+scope) 写入 ~/.npmrc 处理，
# 注入 NODE_AUTH_TOKEN=${{ secrets.GITHUB_TOKEN }}（permissions: packages: write）。
# 此处仅声明 scope→registry 路由；本地 @hulianui/* 为 workspace:* 内部解析。
@hulianui:registry=https://npm.pkg.github.com
