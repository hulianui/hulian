{
  "name": "hulian",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@8.15.5",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "pnpm": ">=8.15.5 <9"
  },
  "scripts": {
    "kill:stale": "pkill -f '[h]ulian-desktop' 2>/dev/null; lsof -t -i:5512 -i:5514 2>/dev/null | xargs kill -9 2>/dev/null; for pid in $(pgrep -f 'next dev'); do cwd=$(lsof -a -p $pid -d cwd -Fn 2>/dev/null | sed -n 's/^n//p' | head -1); case $cwd in $PWD/apps/www*) kill -9 $pid 2>/dev/null;; esac; done; true",
    "dev": "pnpm kill:stale; turbo run dev --filter=www",
    "app": "pnpm kill:stale; pnpm --filter desktop dev",
    "app:build": "pnpm --filter desktop build",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:scripts": "node --test scripts/*.test.mjs",
    "doctor": "react-doctor -y --diff false --lint --no-score",
    "size": "bash scripts/bundle-size.sh",
    "size:update": "bash scripts/bundle-size.sh --update",
    "compile-cost": "bash scripts/compile-cost.sh",
    "readme:sync": "node scripts/readme-counts.mjs",
    "skill-index": "node scripts/gen-skill-index.mjs",
    "component-docs": "node scripts/gen-component-docs.mjs",
    "showcase:generate": "node scripts/gen-showcase-sources.mjs",
    "showcase:check": "node scripts/gen-showcase-sources.mjs --check",
    "llms-registry": "node scripts/gen-llms-registry.mjs",
    "registry:smoke:pages": "node scripts/registry-pages-smoke.mjs",
    "a11y": "node scripts/a11y.mjs",
    "viewport": "node scripts/viewport.mjs",
    "gallery": "node scripts/gallery-budget.mjs",
    "conventions": "node scripts/gen-conventions.mjs",
    "conventions:check": "node scripts/gen-conventions.mjs --check",
    "candidates:check": "node scripts/check-tailwind-candidates.mjs",
    "docs:check:props": "node scripts/check-component-doc-props.mjs",
    "guard": "node packages/guard/src/cli.mjs",
    "changelog": "node scripts/gen-changelog.mjs",
    "docs:all": "pnpm skill-index && pnpm component-docs && pnpm showcase:generate && pnpm llms-registry && pnpm conventions && pnpm changelog",
    "docs:build": "node scripts/build-bilingual-docs.mjs",
    "docs:check:artifacts": "node --test scripts/gen-llms-registry-i18n.test.mjs",
    "docs:check:output": "node scripts/check-bilingual-docs-output.mjs",
    "docs:check:routes": "node scripts/build-bilingual-docs.mjs --check-routes",
    "docs:check:admin-demos": "node scripts/check-admin-demo-output.mjs apps/www/out",
    "docs:check:task11-demos": "node scripts/check-task11-demo-output.mjs apps/www/out",
    "docs:check:task12-demos": "node scripts/check-task12-demo-output.mjs apps/www/out",
    "docs:check:showcase-browser": "node scripts/check-showcase-english-browser.mjs",
    "docs:i18n:check": "node scripts/check-component-doc-translations.mjs",
    "docs:i18n:output": "node scripts/check-english-output.mjs apps/www/out",
    "docs:i18n:links": "node scripts/check-bilingual-links.mjs apps/www/out",
    "docs:verify:public": "node scripts/verify-public-bilingual-sites.mjs",
    "install-hooks": "sh scripts/install-hooks.sh",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm llms-registry && pnpm changelog",
    "release": "changeset publish",
    "scan": "node scripts/hulian-scan.mjs --full --environment workspace",
    "scan:ci": "node scripts/hulian-scan.mjs --ci --environment packed-consumer",
    "scan:update": "node scripts/hulian-scan.mjs --update --full --environment packed-consumer"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@changesets/cli": "^2.31.1",
    "cheerio": "^1.2.0",
    "playwright": "^1.62.1",
    "react-doctor": "^0.2.14",
    "turbo": "^2.10.8",
    "typescript": "^7.0.2",
    "typescript-api": "npm:typescript@^5.9.3"
  },
  "pnpm": {}
}
