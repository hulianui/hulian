{
  "name": "hulian",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@8.15.5",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "pnpm": ">=8.15.5 <9"
  },
  "scripts": {
    "kill:stale": "pkill -f '[h]ulian-desktop' 2>/dev/null; lsof -t -i:5512 -i:5514 2>/dev/null | xargs kill -9 2>/dev/null; for pid in $(pgrep -f 'next dev'); do cwd=$(lsof -a -p $pid -d cwd -Fn 2>/dev/null | sed -n 's/^n//p' | head -1); case $cwd in $PWD/apps/www*) kill -9 $pid 2>/dev/null;; esac; done; true",
    "dev": "pnpm kill:stale; turbo run dev --filter=www",
    "app": "pnpm kill:stale; pnpm --filter desktop dev",
    "app:build": "pnpm --filter desktop build",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:scripts": "node --test scripts/*.test.mjs",
    "doctor": "react-doctor -y --diff false --lint --no-score",
    "size": "bash scripts/bundle-size.sh",
    "size:update": "bash scripts/bundle-size.sh --update",
    "compile-cost": "bash scripts/compile-cost.sh",
    "skill-index": "node scripts/gen-skill-index.mjs",
    "component-docs": "node scripts/gen-component-docs.mjs",
    "llms-registry": "node scripts/gen-llms-registry.mjs",
    "registry:smoke:pages": "node scripts/registry-pages-smoke.mjs",
    "a11y": "node scripts/a11y.mjs",
    "viewport": "node scripts/viewport.mjs",
    "gallery": "node scripts/gallery-budget.mjs",
    "conventions": "node scripts/gen-conventions.mjs",
    "conventions:check": "node scripts/gen-conventions.mjs --check",
    "guard": "node packages/guard/src/cli.mjs",
    "changelog": "node scripts/gen-changelog.mjs",
    "docs:all": "pnpm skill-index && pnpm component-docs && pnpm llms-registry && pnpm conventions && pnpm changelog",
    "install-hooks": "sh scripts/install-hooks.sh",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm llms-registry && pnpm changelog",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@changesets/cli": "^2.31.1",
    "playwright": "^1.62.1",
    "react-doctor": "^0.2.14",
    "turbo": "^2.10.8",
    "typescript": "^7.0.2",
    "typescript-api": "npm:typescript@^5.9.3"
  },
  "pnpm": {}
}
