{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    // 不在 strict 家族里，须单独开。对「发源码」的包这不是风格项：库没开的检查项
    // 都是漏给消费方的雷 —— 消费方的 tsconfig 只会比库更严，而 skipLibCheck 只跳
    // .d.ts、跳不过我们发出去的 .tsx 源码（hulianui/hulian#31）。
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "declaration": true,
    "noEmit": true
  }
}
